Screen { background: $surface; }

#status {
    dock: top;
    height: 1;
    background: $primary 10%;
    color: $text;
    padding: 0 1;
    text-style: bold;
}

#chat {
    height: 1fr;
    background: $surface;
    padding: 1 2;
}

#input {
    dock: bottom;
    height: 5;
    background: $boost;
    border: solid $primary;
}

#completion-popup {
    dock: bottom;
    height: auto;
    max-height: 12;
    background: $surface;
    border: solid $accent;
    padding: 0 1;
}

.completion-option {
    padding: 0 1;
}

.completion-option.selected {
    background: $accent;
    color: $text;
}

.logo {
    color: cyan;
    text-align: center;
    text-style: bold;
}

#subtitle {
    text-align: center;
    color: $text-muted;
}
